# SOARCA settings. Every variable SOARCA reads is listed here; see
# internal/config/config.go for the defaults and
# https://cossas.github.io/SOARCA/docs/installation-configuration/ for details.

### Server
PORT: 8080
ENABLE_TLS: false
CERT_FILE: "./certs/server.crt"
CERT_KEY_FILE: "./certs/server.key"
GIN_MODE: "release"
# Comma-separated, or "*" for any origin.
SOARCA_ALLOWED_ORIGINS: "*"

### Execution
MAX_EXECUTIONS: 10
MAX_REPORTERS: 10
# Empty uses the CACAO v2 schema embedded in SOARCA.
VALIDATION_SCHEMA_URL: ""
HTTP_SKIP_CERT_VALIDATION: false

### Database
DATABASE: false
MONGODB_URI: "mongodb://localhost:27017"
DB_USERNAME: "root"
DB_PASSWORD: "rootpassword"

### Logging
LOG_GLOBAL_LEVEL: "info"
LOG_MODE: "production"
LOG_FILE_PATH: ""
LOG_FORMAT: "json"

### Fins (MQTT)
ENABLE_FINS: false
MQTT_BROKER: "localhost"
MQTT_PORT: 1883

### Integrations

# The Hive
THEHIVE_ACTIVATE: false
THEHIVE_API_TOKEN: "your_token"
THEHIVE_API_BASE_URL: "http://your.thehive.instance/api/v1/"
THEHIVE_ALLOW_INSECURE: true
THEHIVE_REPORTER: false

### Authentication
# With AUTH_ENABLED: true, configure at least one provider below.
AUTH_ENABLED: false

# OpenID Connect provider, e.g. authentik
OIDC_ISSUER: "https://authentikuri:9443/application/o/soarca/"
OIDC_CLIENT_ID: "some client ID"
OIDC_SKIP_TLS_VERIFY: false
# Members of this group get every permission.
AUTH_GROUP: "soarca_admin"

# Microsoft Entra ID
# AUTH_ENTRA_TENANT_IDS: "<tenant-id>,<tenant-id>"
# AUTH_ENTRA_API_CLIENT_ID: "<client ID of the SOARCA API app registration>"
# AUTH_ENTRA_API_APP_ID_URI: "api://soarca"
# AUTH_ENTRA_ALLOWED_CLIENT_IDS: "<client-id>,<client-id>"
# AUTH_ENTRA_REQUIRED_USER_SCOPE: "access_as_user"
# AUTH_ENTRA_ACCEPT_V1: false
# AUTH_ENTRA_AUTHORITY: "https://login.microsoftonline.com"

# Static API keys
# AUTH_API_KEYS_FILE: "/etc/soarca/api-keys.json"

### SSH key management
ENABLE_SSH_KMS: false
SSH_KMS_DIR: "deployments/docker/testing/ssh-kms-test/ssh-keystore/"
