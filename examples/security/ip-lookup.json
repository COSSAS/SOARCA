{
    "type": "playbook",
    "spec_version": "cacao-2.0",
    "id": "playbook--cd44f6a8-4289-4c9d-a6d6-690353399185",
    "name": "IP reputation to Slack (AbuseIPDB + ip-api.com)",
    "description": "Looks up an IP against AbuseIPDB (reputation) and ip-api.com (geo/ASN), extracts fields from each JSON response using the soarca-assignment/jq step extension, and posts a formatted summary to a Slack incoming webhook. Note: ip-api.com's free tier is HTTP only (port 80); the target reflects that. AbuseIPDB free tier is limited to 1000 checks/day; ip-api.com free tier is 45 requests/min per source IP.",
    "created_by": "identity--9a13c80b-2ac5-44dc-aa8d-15e18c735fa9",
    "created": "2026-05-27T10:00:00.000Z",
    "modified": "2026-05-27T10:00:00.000Z",
    "revoked": false,
    "playbook_variables": {
