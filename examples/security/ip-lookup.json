    "workflow_start": "start--f9d89891-9d52-4fc6-a575-6cba99eb32df",
    "workflow": {
        "start--f9d89891-9d52-4fc6-a575-6cba99eb32df": {
            "type": "start",
            "on_completion": "action--76e07065-8c27-454f-bf62-d1de3176170f"
        },
        "action--76e07065-8c27-454f-bf62-d1de3176170f": {
            "type": "action",
            "name": "AbuseIPDB check",
            "description": "GET /api/v2/check with the IP address; API key in the 'Key' header.",
            "on_completion": "action--5e2547f9-fa5d-4b05-9922-e50e95cbbcec",
            "commands": [
                {
                    "type": "http-api",
                    "command": "GET /api/v2/check?ipAddress=__ip__:value&maxAgeInDays=90 HTTP/1.1",
                    "headers": {
                        "Key": [
                            "__abuse_api_key__:value"
                        ],
                        "Accept": [
                            "application/json"
                        ]
                    }
                }
            ],
            "agent": "soarca--29306bbd-ad5d-47c7-b62e-0e8ac44a6534",
            "targets": [
                "http-api--25803424-0ef8-4a8f-be9e-aac6eacd873e"
            ],
            "step_extensions": {
                "extension-definition--dc3db308-f9fc-473a-9dbd-6772a15fc3a7": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__abuse_score__",
                    "expression": {
                        "type": "jq",
                        "expression": ".data.abuseConfidenceScore"
                    }
                },
                "extension-definition--5f99fef4-d6ef-4b3f-9a57-a7ba191116eb": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__abuse_reports__",
                    "expression": {
                        "type": "jq",
                        "expression": ".data.totalReports"
                    }
                },
                "extension-definition--a48ffcc1-cffa-4537-8568-6ad14f4d38b5": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__abuse_country__",
                    "expression": {
                        "type": "jq",
                        "expression": ".data.countryCode"
                    }
                },
                "extension-definition--8a5022ca-bff9-4df4-881b-232dfd960b80": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__abuse_isp__",
                    "expression": {
                        "type": "jq",
                        "expression": ".data.isp"
                    }
                },
                "extension-definition--6239eccb-7a08-4f67-a738-3de50d2ad9ad": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__abuse_usage__",
                    "expression": {
                        "type": "jq",
                        "expression": ".data.usageType"
                    }
                },
                "extension-definition--3ffc69c4-d6cc-4246-89ae-faa9dea72409": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__abuse_last_reported__",
                    "expression": {
                        "type": "jq",
                        "expression": ".data.lastReportedAt"
                    }
                }
            }
        },
        "action--5e2547f9-fa5d-4b05-9922-e50e95cbbcec": {
            "type": "action",
            "name": "ip-api.com geolocation",
            "description": "GET /json/<ip> - free tier is HTTP only, no auth. Response is a flat JSON object.",
            "on_completion": "action--0d49e534-11c4-4faf-8cda-348d4786c65c",
            "commands": [
                {
                    "type": "http-api",
                    "command": "GET /json/__ip__:value HTTP/1.1",
                    "headers": {
                        "Accept": [
                            "application/json"
                        ]
                    }
                }
            ],
            "agent": "soarca--29306bbd-ad5d-47c7-b62e-0e8ac44a6534",
            "targets": [
                "http-api--0f098f6a-7864-4f1d-a177-c708d8353891"
            ],
            "step_extensions": {
                "extension-definition--d3b19052-67fd-41d3-8ef8-d81ab0cce8a4": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__geo_country__",
                    "expression": {
                        "type": "jq",
                        "expression": ".country"
                    }
                },
                "extension-definition--789d7a39-08a4-433e-81a6-433e2ad0a789": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__geo_city__",
                    "expression": {
                        "type": "jq",
                        "expression": ".city"
                    }
                },
                "extension-definition--dd0de811-a0e9-42d3-8d7b-7088002e911c": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__geo_region__",
                    "expression": {
                        "type": "jq",
                        "expression": ".regionName"
                    }
                },
                "extension-definition--257486fb-7248-4d5a-8f27-18b995618f17": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__geo_isp__",
                    "expression": {
                        "type": "jq",
                        "expression": ".isp"
                    }
                },
                "extension-definition--a966d309-3420-4e09-b761-a4ab7e36daba": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__geo_org__",
                    "expression": {
                        "type": "jq",
                        "expression": ".org"
                    }
                },
                "extension-definition--8575f1ab-35ca-4708-b0bd-108ebffa4b49": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__geo_as__",
                    "expression": {
                        "type": "jq",
                        "expression": ".as"
                    }
                },
                "extension-definition--6431ace6-3a87-44e1-b716-7147c2d1cb46": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__geo_proxy__",
                    "expression": {
                        "type": "jq",
                        "expression": ".proxy"
                    }
                },
                "extension-definition--4e1547a3-ba16-47d7-826c-ea60baa15c5e": {
                    "type": "soarca-assignment",
                    "step-result": "__soarca_http_api_result__",
                    "variable": "__geo_hosting__",
                    "expression": {
                        "type": "jq",
                        "expression": ".hosting"
                    }
                }
            }
        },
        "action--0d49e534-11c4-4faf-8cda-348d4786c65c": {
            "type": "action",
            "name": "Post reputation summary to Slack",
            "description": "POST to Slack incoming webhook. Body interpolates all extracted variables.",
            "on_completion": "end--2fa5a7b3-ac97-44a9-b3ee-7f35a545e9df",
            "commands": [
                {
                    "type": "http-api",
                    "command": "POST __slack_webhook_path__:value HTTP/1.1",
                    "content": "{\"text\": \"*IP reputation report for __ip__:value*\\n\\n*AbuseIPDB*\\n\\u2022 Confidence score: __abuse_score__:value / 100\\n\\u2022 Total reports: __abuse_reports__:value\\n\\u2022 Country: __abuse_country__:value\\n\\u2022 ISP: __abuse_isp__:value\\n\\u2022 Usage type: __abuse_usage__:value\\n\\u2022 Last reported: __abuse_last_reported__:value\\n\\n*Geolocation (ip-api.com)*\\n\\u2022 Location: __geo_city__:value, __geo_region__:value, __geo_country__:value\\n\\u2022 Network: __geo_isp__:value / __geo_org__:value\\n\\u2022 AS: __geo_as__:value\\n\\u2022 Flags: proxy=__geo_proxy__:value, hosting=__geo_hosting__:value\"}",
                    "headers": {
                        "Content-Type": [
                            "application/json"
                        ]
                    }
                }
            ],
            "agent": "soarca--29306bbd-ad5d-47c7-b62e-0e8ac44a6534",
            "targets": [
                "http-api--93d4c873-605b-4149-b309-40030054c93f"
            ]
        },
        "end--2fa5a7b3-ac97-44a9-b3ee-7f35a545e9df": {
            "type": "end",
            "name": "Reputation posted"
        }
    },
